# systemd unit for stiebel_exporter, e.g. /etc/systemd/system/stiebel_exporter.service
# The CAN interface (can0) has to be up before the service starts, e.g. via systemd-networkd:
#   /etc/systemd/network/80-can.network: [Match] Name=can0 / [CAN] BitRate=20K
[Unit]
Description=Prometheus exporter for Stiebel Eltron heat pumps (CAN bus)
Documentation=https://github.com/thomashoell/stiebel_exporter
Wants=network-online.target
After=network-online.target sys-subsystem-net-devices-can0.device
BindsTo=sys-subsystem-net-devices-can0.device

[Service]
ExecStart=/usr/local/bin/stiebel_exporter -device can0 -listen :9000
Restart=on-failure
RestartSec=10s

# reading and writing raw CAN frames needs no privileges
DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_CAN AF_INET AF_INET6 AF_UNIX AF_NETLINK
# no SystemCallArchitectures=native: on a 32 bit userland with a 64 bit kernel (e.g. Raspberry Pi OS armhf on a
# Pi 3 or newer), "native" means arm64 and the seccomp filter kills the armv7 binary with SIGSYS

[Install]
WantedBy=multi-user.target
